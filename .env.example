# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-your-key-here

# Optional overrides (defaults shown)
# OPENAI_MODEL=gpt-5.4                 # main agent with tool calling
# OPENAI_ROUTER_MODEL=gpt-5.4-mini     # intent router
# OPENAI_REFLECTION_MODEL=gpt-5.4-mini # reflection / self-check pass
# ENABLE_REFLECTION=true
# BUSINESS_BOT_DATA_DIR=data           # where leads.jsonl, feedback.jsonl and agent.log are written

# Optional: real push notifications for new leads and feedback (https://pushover.net)
# PUSHOVER_USER=
# PUSHOVER_TOKEN=
